#!/bin/sh
# Generated by build.py — do not edit by hand.
set -e
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
RESOLVED=$("$DIR/resolver.py" 'SCRAPECREATORS_API_KEY?') || exit $?
while IFS='=' read -r key value; do
  [ -n "$key" ] && export "$key=$value"
done <<EOF
$RESOLVED
EOF
exec "${LAST30DAYS_PYTHON:-python3}" "$DIR/../skills/last30days/scripts/last30days.py" "$@"
