{
  "inputs": [
    {
      "type": "promptString",
      "id": "zotero-research_zotero_api_key",
      "description": "RESEARCH_ZOTERO_API_KEY",
      "password": true
    },
    {
      "type": "promptString",
      "id": "zotero-research_zotero_library_id",
      "description": "RESEARCH_ZOTERO_LIBRARY_ID",
      "password": true
    },
    {
      "type": "promptString",
      "id": "zotero-research_zotero_library_type",
      "description": "RESEARCH_ZOTERO_LIBRARY_TYPE",
      "password": true
    }
  ],
  "servers": {
    "zotero": {
      "type": "stdio",
      "command": "env",
      "args": [
        "ZOTERO_LOCAL=true",
        "ZOTERO_API_KEY=${RESEARCH_ZOTERO_API_KEY}",
        "ZOTERO_LIBRARY_ID=${RESEARCH_ZOTERO_LIBRARY_ID}",
        "ZOTERO_LIBRARY_TYPE=${RESEARCH_ZOTERO_LIBRARY_TYPE}",
        "zotero-mcp"
      ],
      "env": {
        "RESEARCH_ZOTERO_API_KEY": "${input:zotero-research_zotero_api_key}",
        "RESEARCH_ZOTERO_LIBRARY_ID": "${input:zotero-research_zotero_library_id}",
        "RESEARCH_ZOTERO_LIBRARY_TYPE": "${input:zotero-research_zotero_library_type}"
      }
    },
    "notebooklm": {
      "type": "stdio",
      "command": "notebooklm-mcp",
      "args": []
    }
  }
}
