{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "zotero": {
      "command": "env",
      "args": [
        "ZOTERO_LOCAL=true",
        "ZOTERO_API_KEY=${INTEGRATIONS_ZOTERO_API_KEY}",
        "ZOTERO_LIBRARY_ID=${INTEGRATIONS_ZOTERO_LIBRARY_ID}",
        "ZOTERO_LIBRARY_TYPE=${INTEGRATIONS_ZOTERO_LIBRARY_TYPE}",
        "zotero-mcp"
      ],
      "env": {
        "INTEGRATIONS_ZOTERO_API_KEY": "${INTEGRATIONS_ZOTERO_API_KEY}",
        "INTEGRATIONS_ZOTERO_LIBRARY_ID": "${INTEGRATIONS_ZOTERO_LIBRARY_ID}",
        "INTEGRATIONS_ZOTERO_LIBRARY_TYPE": "${INTEGRATIONS_ZOTERO_LIBRARY_TYPE}"
      }
    },
    "notebooklm": {
      "command": "notebooklm-mcp",
      "args": []
    },
    "exa": {
      "command": "npx",
      "args": [
        "-y",
        "exa-mcp-server"
      ],
      "env": {
        "INTEGRATIONS_EXA_API_KEY": "${INTEGRATIONS_EXA_API_KEY}"
      }
    },
    "pgquery": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "DATABASE_URI=${INTEGRATIONS_PGQUERY_URI}",
        "crystaldba/postgres-mcp",
        "--access-mode=restricted",
        "--transport=stdio"
      ],
      "env": {
        "INTEGRATIONS_PGQUERY_URI": "${INTEGRATIONS_PGQUERY_URI}"
      }
    },
    "dbtools": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "${INTEGRATIONS_DBTOOLS_CONFIG_PATH}:/tools.yaml:ro",
        "us-central1-docker.pkg.dev/database-toolbox/toolbox/toolbox:latest",
        "--stdio",
        "--config",
        "/tools.yaml"
      ],
      "env": {
        "INTEGRATIONS_DBTOOLS_CONFIG_PATH": "${INTEGRATIONS_DBTOOLS_CONFIG_PATH}"
      }
    },
    "mysql-mcp": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "MYSQL_HOST=${INTEGRATIONS_MYSQL_MCP_HOST}",
        "-e",
        "MYSQL_USER=${INTEGRATIONS_MYSQL_MCP_USER}",
        "-e",
        "MYSQL_PASS=${INTEGRATIONS_MYSQL_MCP_PASS}",
        "-e",
        "MYSQL_DB=${INTEGRATIONS_MYSQL_MCP_DB}",
        "-e",
        "ALLOW_INSERT_OPERATION=false",
        "-e",
        "ALLOW_UPDATE_OPERATION=false",
        "-e",
        "ALLOW_DELETE_OPERATION=false",
        "indie-marketplace-mysql-mcp:local"
      ],
      "env": {
        "INTEGRATIONS_MYSQL_MCP_HOST": "${INTEGRATIONS_MYSQL_MCP_HOST}",
        "INTEGRATIONS_MYSQL_MCP_USER": "${INTEGRATIONS_MYSQL_MCP_USER}",
        "INTEGRATIONS_MYSQL_MCP_PASS": "${INTEGRATIONS_MYSQL_MCP_PASS}",
        "INTEGRATIONS_MYSQL_MCP_DB": "${INTEGRATIONS_MYSQL_MCP_DB}"
      }
    },
    "mssql-mcp": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "MSSQL_HOST=${INTEGRATIONS_MSSQL_MCP_HOST}",
        "-e",
        "MSSQL_DATABASE=${INTEGRATIONS_MSSQL_MCP_DATABASE}",
        "-e",
        "MSSQL_USER=${INTEGRATIONS_MSSQL_MCP_USER}",
        "-e",
        "MSSQL_PASSWORD=${INTEGRATIONS_MSSQL_MCP_PASSWORD}",
        "indie-marketplace-mssql-mcp:local"
      ],
      "env": {
        "INTEGRATIONS_MSSQL_MCP_HOST": "${INTEGRATIONS_MSSQL_MCP_HOST}",
        "INTEGRATIONS_MSSQL_MCP_DATABASE": "${INTEGRATIONS_MSSQL_MCP_DATABASE}",
        "INTEGRATIONS_MSSQL_MCP_USER": "${INTEGRATIONS_MSSQL_MCP_USER}",
        "INTEGRATIONS_MSSQL_MCP_PASSWORD": "${INTEGRATIONS_MSSQL_MCP_PASSWORD}"
      }
    },
    "azcloud": {
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ]
    },
    "azdevops": {
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp",
        "${INTEGRATIONS_AZDEVOPS_ORG}",
        "--authentication",
        "azcli"
      ],
      "env": {
        "INTEGRATIONS_AZDEVOPS_ORG": "${INTEGRATIONS_AZDEVOPS_ORG}"
      }
    },
    "azaks": {
      "command": "${INTEGRATIONS_AZAKS_BIN}",
      "args": [
        "--transport",
        "stdio"
      ],
      "env": {
        "INTEGRATIONS_AZAKS_BIN": "${INTEGRATIONS_AZAKS_BIN}"
      }
    },
    "azkusto": {
      "command": "env",
      "args": [
        "KUSTO_AUTH_METHOD=azure-identity",
        "KUSTO_ALLOW_WRITE_OPERATIONS=false",
        "KUSTO_CLUSTER_URL=${INTEGRATIONS_AZKUSTO_CLUSTER_URL}",
        "KUSTO_DEFAULT_DATABASE=${INTEGRATIONS_AZKUSTO_DATABASE}",
        "AZURE_TENANT_ID=${INTEGRATIONS_AZKUSTO_TENANT_ID}",
        "AZURE_CLIENT_ID=${INTEGRATIONS_AZKUSTO_CLIENT_ID}",
        "AZURE_CLIENT_SECRET=${INTEGRATIONS_AZKUSTO_CLIENT_SECRET}",
        "npx",
        "-y",
        "kusto-mcp"
      ],
      "env": {
        "INTEGRATIONS_AZKUSTO_CLUSTER_URL": "${INTEGRATIONS_AZKUSTO_CLUSTER_URL}",
        "INTEGRATIONS_AZKUSTO_DATABASE": "${INTEGRATIONS_AZKUSTO_DATABASE}",
        "INTEGRATIONS_AZKUSTO_TENANT_ID": "${INTEGRATIONS_AZKUSTO_TENANT_ID}",
        "INTEGRATIONS_AZKUSTO_CLIENT_ID": "${INTEGRATIONS_AZKUSTO_CLIENT_ID}",
        "INTEGRATIONS_AZKUSTO_CLIENT_SECRET": "${INTEGRATIONS_AZKUSTO_CLIENT_SECRET}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    }
  }
}
