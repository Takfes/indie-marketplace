{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "zotero": {
      "command": "env",
      "args": [
        "ZOTERO_LOCAL=true",
        "ZOTERO_API_KEY=${ZOTERO_API_KEY}",
        "ZOTERO_LIBRARY_ID=${ZOTERO_LIBRARY_ID}",
        "ZOTERO_LIBRARY_TYPE=${ZOTERO_LIBRARY_TYPE}",
        "zotero-mcp"
      ],
      "env": {
        "ZOTERO_API_KEY": "${ZOTERO_API_KEY}",
        "ZOTERO_LIBRARY_ID": "${ZOTERO_LIBRARY_ID}",
        "ZOTERO_LIBRARY_TYPE": "${ZOTERO_LIBRARY_TYPE}"
      }
    },
    "notebooklm": {
      "command": "notebooklm-mcp",
      "args": []
    },
    "exa": {
      "command": "npx",
      "args": [
        "-y",
        "exa-mcp-server"
      ],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      }
    },
    "pgquery": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "DATABASE_URI=${PGQUERY_URI}",
        "crystaldba/postgres-mcp",
        "--access-mode=restricted",
        "--transport=stdio"
      ],
      "env": {
        "PGQUERY_URI": "${PGQUERY_URI}"
      }
    },
    "dbtools": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "${DBTOOLS_CONFIG_PATH}:/tools.yaml:ro",
        "us-central1-docker.pkg.dev/database-toolbox/toolbox/toolbox:latest",
        "--stdio",
        "--config",
        "/tools.yaml"
      ],
      "env": {
        "DBTOOLS_CONFIG_PATH": "${DBTOOLS_CONFIG_PATH}"
      }
    },
    "mysql-mcp": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "MYSQL_HOST=${MYSQL_MCP_HOST}",
        "-e",
        "MYSQL_USER=${MYSQL_MCP_USER}",
        "-e",
        "MYSQL_PASS=${MYSQL_MCP_PASS}",
        "-e",
        "MYSQL_DB=${MYSQL_MCP_DB}",
        "-e",
        "ALLOW_INSERT_OPERATION=false",
        "-e",
        "ALLOW_UPDATE_OPERATION=false",
        "-e",
        "ALLOW_DELETE_OPERATION=false",
        "indie-marketplace-mysql-mcp:local"
      ],
      "env": {
        "MYSQL_MCP_HOST": "${MYSQL_MCP_HOST}",
        "MYSQL_MCP_USER": "${MYSQL_MCP_USER}",
        "MYSQL_MCP_PASS": "${MYSQL_MCP_PASS}",
        "MYSQL_MCP_DB": "${MYSQL_MCP_DB}"
      }
    },
    "mssql-mcp": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "MSSQL_HOST=${MSSQL_MCP_HOST}",
        "-e",
        "MSSQL_DATABASE=${MSSQL_MCP_DATABASE}",
        "-e",
        "MSSQL_USER=${MSSQL_MCP_USER}",
        "-e",
        "MSSQL_PASSWORD=${MSSQL_MCP_PASSWORD}",
        "indie-marketplace-mssql-mcp:local"
      ],
      "env": {
        "MSSQL_MCP_HOST": "${MSSQL_MCP_HOST}",
        "MSSQL_MCP_DATABASE": "${MSSQL_MCP_DATABASE}",
        "MSSQL_MCP_USER": "${MSSQL_MCP_USER}",
        "MSSQL_MCP_PASSWORD": "${MSSQL_MCP_PASSWORD}"
      }
    },
    "azcloud": {
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ]
    },
    "azdevops": {
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp",
        "${AZDEVOPS_ORG}",
        "--authentication",
        "azcli"
      ],
      "env": {
        "AZDEVOPS_ORG": "${AZDEVOPS_ORG}"
      }
    },
    "azaks": {
      "command": "${AZAKS_BIN}",
      "args": [
        "--transport",
        "stdio"
      ],
      "env": {
        "AZAKS_BIN": "${AZAKS_BIN}"
      }
    },
    "azkusto": {
      "command": "env",
      "args": [
        "KUSTO_AUTH_METHOD=azure-identity",
        "KUSTO_ALLOW_WRITE_OPERATIONS=false",
        "KUSTO_CLUSTER_URL=${AZKUSTO_CLUSTER_URL}",
        "KUSTO_DEFAULT_DATABASE=${AZKUSTO_DATABASE}",
        "AZURE_TENANT_ID=${AZKUSTO_TENANT_ID}",
        "AZURE_CLIENT_ID=${AZKUSTO_CLIENT_ID}",
        "AZURE_CLIENT_SECRET=${AZKUSTO_CLIENT_SECRET}",
        "npx",
        "-y",
        "kusto-mcp"
      ],
      "env": {
        "AZKUSTO_CLUSTER_URL": "${AZKUSTO_CLUSTER_URL}",
        "AZKUSTO_DATABASE": "${AZKUSTO_DATABASE}",
        "AZKUSTO_TENANT_ID": "${AZKUSTO_TENANT_ID}",
        "AZKUSTO_CLIENT_ID": "${AZKUSTO_CLIENT_ID}",
        "AZKUSTO_CLIENT_SECRET": "${AZKUSTO_CLIENT_SECRET}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    }
  }
}
