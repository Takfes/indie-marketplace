{
  "inputs": [
    {
      "type": "promptString",
      "id": "zotero-zotero_api_key",
      "description": "ZOTERO_API_KEY",
      "password": true
    },
    {
      "type": "promptString",
      "id": "zotero-zotero_library_id",
      "description": "ZOTERO_LIBRARY_ID",
      "password": true
    },
    {
      "type": "promptString",
      "id": "zotero-zotero_library_type",
      "description": "ZOTERO_LIBRARY_TYPE",
      "password": true
    },
    {
      "type": "promptString",
      "id": "exa-exa_api_key",
      "description": "EXA_API_KEY",
      "password": true
    },
    {
      "type": "promptString",
      "id": "pgquery-pgquery_uri",
      "description": "PGQUERY_URI",
      "password": true
    },
    {
      "type": "promptString",
      "id": "dbtools-dbtools_config_path",
      "description": "DBTOOLS_CONFIG_PATH",
      "password": true
    },
    {
      "type": "promptString",
      "id": "mysql-mcp-mysql_mcp_host",
      "description": "MYSQL_MCP_HOST",
      "password": true
    },
    {
      "type": "promptString",
      "id": "mysql-mcp-mysql_mcp_user",
      "description": "MYSQL_MCP_USER",
      "password": true
    },
    {
      "type": "promptString",
      "id": "mysql-mcp-mysql_mcp_pass",
      "description": "MYSQL_MCP_PASS",
      "password": true
    },
    {
      "type": "promptString",
      "id": "mysql-mcp-mysql_mcp_db",
      "description": "MYSQL_MCP_DB",
      "password": true
    },
    {
      "type": "promptString",
      "id": "mssql-mcp-mssql_mcp_host",
      "description": "MSSQL_MCP_HOST",
      "password": true
    },
    {
      "type": "promptString",
      "id": "mssql-mcp-mssql_mcp_database",
      "description": "MSSQL_MCP_DATABASE",
      "password": true
    },
    {
      "type": "promptString",
      "id": "mssql-mcp-mssql_mcp_user",
      "description": "MSSQL_MCP_USER",
      "password": true
    },
    {
      "type": "promptString",
      "id": "mssql-mcp-mssql_mcp_password",
      "description": "MSSQL_MCP_PASSWORD",
      "password": true
    },
    {
      "type": "promptString",
      "id": "azdevops-azdevops_org",
      "description": "AZDEVOPS_ORG",
      "password": true
    },
    {
      "type": "promptString",
      "id": "azaks-azaks_bin",
      "description": "AZAKS_BIN",
      "password": true
    },
    {
      "type": "promptString",
      "id": "azkusto-azkusto_cluster_url",
      "description": "AZKUSTO_CLUSTER_URL",
      "password": true
    },
    {
      "type": "promptString",
      "id": "azkusto-azkusto_database",
      "description": "AZKUSTO_DATABASE",
      "password": true
    },
    {
      "type": "promptString",
      "id": "azkusto-azkusto_tenant_id",
      "description": "AZKUSTO_TENANT_ID",
      "password": true
    },
    {
      "type": "promptString",
      "id": "azkusto-azkusto_client_id",
      "description": "AZKUSTO_CLIENT_ID",
      "password": true
    },
    {
      "type": "promptString",
      "id": "azkusto-azkusto_client_secret",
      "description": "AZKUSTO_CLIENT_SECRET",
      "password": true
    }
  ],
  "servers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "zotero": {
      "type": "stdio",
      "command": "env",
      "args": [
        "ZOTERO_LOCAL=true",
        "ZOTERO_API_KEY=${ZOTERO_API_KEY}",
        "ZOTERO_LIBRARY_ID=${ZOTERO_LIBRARY_ID}",
        "ZOTERO_LIBRARY_TYPE=${ZOTERO_LIBRARY_TYPE}",
        "zotero-mcp"
      ],
      "env": {
        "ZOTERO_API_KEY": "${input:zotero-zotero_api_key}",
        "ZOTERO_LIBRARY_ID": "${input:zotero-zotero_library_id}",
        "ZOTERO_LIBRARY_TYPE": "${input:zotero-zotero_library_type}"
      }
    },
    "notebooklm": {
      "type": "stdio",
      "command": "notebooklm-mcp",
      "args": []
    },
    "exa": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "exa-mcp-server"
      ],
      "env": {
        "EXA_API_KEY": "${input:exa-exa_api_key}"
      }
    },
    "pgquery": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "DATABASE_URI=${PGQUERY_URI}",
        "crystaldba/postgres-mcp",
        "--access-mode=restricted",
        "--transport=stdio"
      ],
      "env": {
        "PGQUERY_URI": "${input:pgquery-pgquery_uri}"
      }
    },
    "dbtools": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "${DBTOOLS_CONFIG_PATH}:/tools.yaml:ro",
        "us-central1-docker.pkg.dev/database-toolbox/toolbox/toolbox:latest",
        "--stdio",
        "--config",
        "/tools.yaml"
      ],
      "env": {
        "DBTOOLS_CONFIG_PATH": "${input:dbtools-dbtools_config_path}"
      }
    },
    "mysql-mcp": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "MYSQL_HOST=${MYSQL_MCP_HOST}",
        "-e",
        "MYSQL_USER=${MYSQL_MCP_USER}",
        "-e",
        "MYSQL_PASS=${MYSQL_MCP_PASS}",
        "-e",
        "MYSQL_DB=${MYSQL_MCP_DB}",
        "-e",
        "ALLOW_INSERT_OPERATION=false",
        "-e",
        "ALLOW_UPDATE_OPERATION=false",
        "-e",
        "ALLOW_DELETE_OPERATION=false",
        "indie-marketplace-mysql-mcp:local"
      ],
      "env": {
        "MYSQL_MCP_HOST": "${input:mysql-mcp-mysql_mcp_host}",
        "MYSQL_MCP_USER": "${input:mysql-mcp-mysql_mcp_user}",
        "MYSQL_MCP_PASS": "${input:mysql-mcp-mysql_mcp_pass}",
        "MYSQL_MCP_DB": "${input:mysql-mcp-mysql_mcp_db}"
      }
    },
    "mssql-mcp": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "MSSQL_HOST=${MSSQL_MCP_HOST}",
        "-e",
        "MSSQL_DATABASE=${MSSQL_MCP_DATABASE}",
        "-e",
        "MSSQL_USER=${MSSQL_MCP_USER}",
        "-e",
        "MSSQL_PASSWORD=${MSSQL_MCP_PASSWORD}",
        "indie-marketplace-mssql-mcp:local"
      ],
      "env": {
        "MSSQL_MCP_HOST": "${input:mssql-mcp-mssql_mcp_host}",
        "MSSQL_MCP_DATABASE": "${input:mssql-mcp-mssql_mcp_database}",
        "MSSQL_MCP_USER": "${input:mssql-mcp-mssql_mcp_user}",
        "MSSQL_MCP_PASSWORD": "${input:mssql-mcp-mssql_mcp_password}"
      }
    },
    "azcloud": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ]
    },
    "azdevops": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp",
        "${AZDEVOPS_ORG}",
        "--authentication",
        "azcli"
      ],
      "env": {
        "AZDEVOPS_ORG": "${input:azdevops-azdevops_org}"
      }
    },
    "azaks": {
      "type": "stdio",
      "command": "${AZAKS_BIN}",
      "args": [
        "--transport",
        "stdio"
      ],
      "env": {
        "AZAKS_BIN": "${input:azaks-azaks_bin}"
      }
    },
    "azkusto": {
      "type": "stdio",
      "command": "env",
      "args": [
        "KUSTO_AUTH_METHOD=azure-identity",
        "KUSTO_ALLOW_WRITE_OPERATIONS=false",
        "KUSTO_CLUSTER_URL=${AZKUSTO_CLUSTER_URL}",
        "KUSTO_DEFAULT_DATABASE=${AZKUSTO_DATABASE}",
        "AZURE_TENANT_ID=${AZKUSTO_TENANT_ID}",
        "AZURE_CLIENT_ID=${AZKUSTO_CLIENT_ID}",
        "AZURE_CLIENT_SECRET=${AZKUSTO_CLIENT_SECRET}",
        "npx",
        "-y",
        "kusto-mcp"
      ],
      "env": {
        "AZKUSTO_CLUSTER_URL": "${input:azkusto-azkusto_cluster_url}",
        "AZKUSTO_DATABASE": "${input:azkusto-azkusto_database}",
        "AZKUSTO_TENANT_ID": "${input:azkusto-azkusto_tenant_id}",
        "AZKUSTO_CLIENT_ID": "${input:azkusto-azkusto_client_id}",
        "AZKUSTO_CLIENT_SECRET": "${input:azkusto-azkusto_client_secret}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    }
  }
}
