{
  "mcpServers": {
    "azcloud": {
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ]
    },
    "azdevops": {
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp",
        "${AZDEVOPS_AZDEVOPS_ORG}",
        "--authentication",
        "azcli"
      ],
      "env": {
        "AZDEVOPS_AZDEVOPS_ORG": "${AZDEVOPS_AZDEVOPS_ORG}"
      }
    },
    "azaks": {
      "command": "${AZDEVOPS_AZAKS_BIN}",
      "args": [
        "--transport",
        "stdio"
      ],
      "env": {
        "AZDEVOPS_AZAKS_BIN": "${AZDEVOPS_AZAKS_BIN}"
      }
    },
    "azkusto": {
      "command": "env",
      "args": [
        "KUSTO_AUTH_METHOD=azure-identity",
        "KUSTO_ALLOW_WRITE_OPERATIONS=false",
        "KUSTO_CLUSTER_URL=${AZDEVOPS_AZKUSTO_CLUSTER_URL}",
        "KUSTO_DEFAULT_DATABASE=${AZDEVOPS_AZKUSTO_DATABASE}",
        "AZURE_TENANT_ID=${AZDEVOPS_AZKUSTO_TENANT_ID}",
        "AZURE_CLIENT_ID=${AZDEVOPS_AZKUSTO_CLIENT_ID}",
        "AZURE_CLIENT_SECRET=${AZDEVOPS_AZKUSTO_CLIENT_SECRET}",
        "npx",
        "-y",
        "kusto-mcp"
      ],
      "env": {
        "AZDEVOPS_AZKUSTO_CLUSTER_URL": "${AZDEVOPS_AZKUSTO_CLUSTER_URL}",
        "AZDEVOPS_AZKUSTO_DATABASE": "${AZDEVOPS_AZKUSTO_DATABASE}",
        "AZDEVOPS_AZKUSTO_TENANT_ID": "${AZDEVOPS_AZKUSTO_TENANT_ID}",
        "AZDEVOPS_AZKUSTO_CLIENT_ID": "${AZDEVOPS_AZKUSTO_CLIENT_ID}",
        "AZDEVOPS_AZKUSTO_CLIENT_SECRET": "${AZDEVOPS_AZKUSTO_CLIENT_SECRET}"
      }
    }
  }
}
