#!/bin/sh
# Generated by build.py — do not edit by hand.
set -e
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
RESOLVED=$("$DIR/resolver.py" AZAKS_BIN) || exit $?
while IFS='=' read -r key value; do
  [ -n "$key" ] && export "$key=$value"
done <<EOF
$RESOLVED
EOF
exec "$AZAKS_BIN" --transport stdio
