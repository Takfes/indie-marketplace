#!/bin/sh
# Generated by build.py — do not edit by hand.
set -e
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
RESOLVED=$("$DIR/resolver.py" AZKUSTO_CLUSTER_URL AZKUSTO_DATABASE AZKUSTO_TENANT_ID AZKUSTO_CLIENT_ID AZKUSTO_CLIENT_SECRET) || exit $?
while IFS='=' read -r key value; do
  [ -n "$key" ] && export "$key=$value"
done <<EOF
$RESOLVED
EOF
export KUSTO_AUTH_METHOD=azure-identity
export KUSTO_ALLOW_WRITE_OPERATIONS=false
export KUSTO_CLUSTER_URL="$AZKUSTO_CLUSTER_URL"
export KUSTO_DEFAULT_DATABASE="$AZKUSTO_DATABASE"
export AZURE_TENANT_ID="$AZKUSTO_TENANT_ID"
export AZURE_CLIENT_ID="$AZKUSTO_CLIENT_ID"
export AZURE_CLIENT_SECRET="$AZKUSTO_CLIENT_SECRET"
exec npx -y kusto-mcp
