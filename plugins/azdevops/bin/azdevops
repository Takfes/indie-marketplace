#!/bin/sh
# Generated by build.py — do not edit by hand.
set -e
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
RESOLVED=$("$DIR/resolver.py" AZDEVOPS_ORG) || exit $?
while IFS='=' read -r key value; do
  [ -n "$key" ] && export "$key=$value"
done <<EOF
$RESOLVED
EOF
exec npx -y @azure-devops/mcp "$AZDEVOPS_ORG" --authentication azcli
