{
  "inputs": [
    {
      "type": "promptString",
      "id": "pgquery-database_pgquery_uri",
      "description": "DATABASE_PGQUERY_URI",
      "password": true
    },
    {
      "type": "promptString",
      "id": "dbtools-database_dbtools_config_path",
      "description": "DATABASE_DBTOOLS_CONFIG_PATH",
      "password": true
    }
  ],
  "servers": {
    "pgquery": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "DATABASE_URI=${DATABASE_PGQUERY_URI}",
        "crystaldba/postgres-mcp",
        "--access-mode=restricted",
        "--transport=stdio"
      ],
      "env": {
        "DATABASE_PGQUERY_URI": "${input:pgquery-database_pgquery_uri}"
      }
    },
    "dbtools": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "${DATABASE_DBTOOLS_CONFIG_PATH}:/tools.yaml:ro",
        "us-central1-docker.pkg.dev/database-toolbox/toolbox/toolbox:latest",
        "--stdio",
        "--config",
        "/tools.yaml"
      ],
      "env": {
        "DATABASE_DBTOOLS_CONFIG_PATH": "${input:dbtools-database_dbtools_config_path}"
      }
    }
  }
}
