{
  "inputs": [
    {
      "type": "promptString",
      "id": "pgquery-database_pgquery_uri",
      "description": "DATABASE_PGQUERY_URI",
      "password": true
    },
    {
      "type": "promptString",
      "id": "dbtools-database_dbtools_config_path",
      "description": "DATABASE_DBTOOLS_CONFIG_PATH",
      "password": true
    },
    {
      "type": "promptString",
      "id": "azkusto-database_azkusto_cluster_url",
      "description": "DATABASE_AZKUSTO_CLUSTER_URL",
      "password": true
    },
    {
      "type": "promptString",
      "id": "azkusto-database_azkusto_database",
      "description": "DATABASE_AZKUSTO_DATABASE",
      "password": true
    },
    {
      "type": "promptString",
      "id": "azkusto-database_azkusto_tenant_id",
      "description": "DATABASE_AZKUSTO_TENANT_ID",
      "password": true
    },
    {
      "type": "promptString",
      "id": "azkusto-database_azkusto_client_id",
      "description": "DATABASE_AZKUSTO_CLIENT_ID",
      "password": true
    },
    {
      "type": "promptString",
      "id": "azkusto-database_azkusto_client_secret",
      "description": "DATABASE_AZKUSTO_CLIENT_SECRET",
      "password": true
    }
  ],
  "servers": {
    "pgquery": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "DATABASE_URI=${DATABASE_PGQUERY_URI}",
        "crystaldba/postgres-mcp",
        "--access-mode=restricted",
        "--transport=stdio"
      ],
      "env": {
        "DATABASE_PGQUERY_URI": "${input:pgquery-database_pgquery_uri}"
      }
    },
    "dbtools": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "${DATABASE_DBTOOLS_CONFIG_PATH}:/tools.yaml:ro",
        "us-central1-docker.pkg.dev/database-toolbox/toolbox/toolbox:latest",
        "--stdio",
        "--config",
        "/tools.yaml"
      ],
      "env": {
        "DATABASE_DBTOOLS_CONFIG_PATH": "${input:dbtools-database_dbtools_config_path}"
      }
    },
    "azkusto": {
      "type": "stdio",
      "command": "env",
      "args": [
        "KUSTO_AUTH_METHOD=azure-identity",
        "KUSTO_ALLOW_WRITE_OPERATIONS=false",
        "KUSTO_CLUSTER_URL=${DATABASE_AZKUSTO_CLUSTER_URL}",
        "KUSTO_DEFAULT_DATABASE=${DATABASE_AZKUSTO_DATABASE}",
        "AZURE_TENANT_ID=${DATABASE_AZKUSTO_TENANT_ID}",
        "AZURE_CLIENT_ID=${DATABASE_AZKUSTO_CLIENT_ID}",
        "AZURE_CLIENT_SECRET=${DATABASE_AZKUSTO_CLIENT_SECRET}",
        "npx",
        "-y",
        "kusto-mcp"
      ],
      "env": {
        "DATABASE_AZKUSTO_CLUSTER_URL": "${input:azkusto-database_azkusto_cluster_url}",
        "DATABASE_AZKUSTO_DATABASE": "${input:azkusto-database_azkusto_database}",
        "DATABASE_AZKUSTO_TENANT_ID": "${input:azkusto-database_azkusto_tenant_id}",
        "DATABASE_AZKUSTO_CLIENT_ID": "${input:azkusto-database_azkusto_client_id}",
        "DATABASE_AZKUSTO_CLIENT_SECRET": "${input:azkusto-database_azkusto_client_secret}"
      }
    }
  }
}
