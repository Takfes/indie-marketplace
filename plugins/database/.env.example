# dbtools
DBTOOLS_CONFIG_PATH=

# mysql-mcp
MYSQL_MCP_HOST=
MYSQL_MCP_USER=
MYSQL_MCP_PASS=
MYSQL_MCP_DB=

# mssql-mcp
MSSQL_MCP_HOST=
MSSQL_MCP_DATABASE=
MSSQL_MCP_USER=
MSSQL_MCP_PASSWORD=
