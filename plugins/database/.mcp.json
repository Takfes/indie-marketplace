{
  "mcpServers": {
    "pgquery": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "DATABASE_URI=${DATABASE_PGQUERY_URI}",
        "crystaldba/postgres-mcp",
        "--access-mode=restricted",
        "--transport=stdio"
      ],
      "env": {
        "DATABASE_PGQUERY_URI": "${DATABASE_PGQUERY_URI}"
      }
    },
    "dbtools": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "${DATABASE_DBTOOLS_CONFIG_PATH}:/tools.yaml:ro",
        "us-central1-docker.pkg.dev/database-toolbox/toolbox/toolbox:latest",
        "--stdio",
        "--config",
        "/tools.yaml"
      ],
      "env": {
        "DATABASE_DBTOOLS_CONFIG_PATH": "${DATABASE_DBTOOLS_CONFIG_PATH}"
      }
    }
  }
}
