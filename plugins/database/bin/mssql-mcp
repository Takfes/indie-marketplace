#!/bin/sh
# Generated by build.py — do not edit by hand.
set -e
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
RESOLVED=$("$DIR/resolver.py" MSSQL_MCP_HOST MSSQL_MCP_DATABASE MSSQL_MCP_USER MSSQL_MCP_PASSWORD) || exit $?
while IFS='=' read -r key value; do
  [ -n "$key" ] && export "$key=$value"
done <<EOF
$RESOLVED
EOF
export MSSQL_HOST="$MSSQL_MCP_HOST"
export MSSQL_DATABASE="$MSSQL_MCP_DATABASE"
export MSSQL_USER="$MSSQL_MCP_USER"
export MSSQL_PASSWORD="$MSSQL_MCP_PASSWORD"
exec docker run -i --rm -e MSSQL_HOST -e MSSQL_DATABASE -e MSSQL_USER -e MSSQL_PASSWORD takfes/indie-marketplace-mssql-mcp:ef13c17
