#!/bin/sh
# Generated by build.py — do not edit by hand.
set -e
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
RESOLVED=$("$DIR/resolver.py" MYSQL_MCP_HOST MYSQL_MCP_USER MYSQL_MCP_PASS MYSQL_MCP_DB) || exit $?
while IFS='=' read -r key value; do
  [ -n "$key" ] && export "$key=$value"
done <<EOF
$RESOLVED
EOF
export MYSQL_HOST="$MYSQL_MCP_HOST"
export MYSQL_USER="$MYSQL_MCP_USER"
export MYSQL_PASS="$MYSQL_MCP_PASS"
export MYSQL_DB="$MYSQL_MCP_DB"
exec docker run -i --rm -e MYSQL_HOST -e MYSQL_USER -e MYSQL_PASS -e MYSQL_DB -e ALLOW_INSERT_OPERATION=false -e ALLOW_UPDATE_OPERATION=false -e ALLOW_DELETE_OPERATION=false takfes/indie-marketplace-mysql-mcp:b9c714e
