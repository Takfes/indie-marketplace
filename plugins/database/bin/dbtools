#!/bin/sh
# Generated by build.py — do not edit by hand.
set -e
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
RESOLVED=$("$DIR/resolver.py" DBTOOLS_CONFIG_PATH) || exit $?
while IFS='=' read -r key value; do
  [ -n "$key" ] && export "$key=$value"
done <<EOF
$RESOLVED
EOF
exec docker run -i --rm -v "$DBTOOLS_CONFIG_PATH:/tools.yaml:ro" us-central1-docker.pkg.dev/database-toolbox/toolbox/toolbox:latest --stdio --config /tools.yaml
